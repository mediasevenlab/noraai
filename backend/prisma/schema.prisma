generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publicId     Int           @unique @default(autoincrement()) @map("public_id")
  email        String        @unique
  passwordHash String?       @map("password_hash")
  displayName  String?       @map("display_name")
  nickname     String?       @unique(map: "users_nickname_key")
  telegramUsername String?   @unique(map: "users_telegram_username_key") @map("telegram_username")
  telegramPhone    String?   @unique(map: "users_telegram_phone_key") @map("telegram_phone")
  telegramChatId   String?   @unique(map: "users_telegram_chat_id_key") @map("telegram_chat_id")
  role         UserRole      @default(user)
  mealEngine      String        @default("gemini") @map("meal_engine")
  geminiThinking  Boolean       @default(true) @map("gemini_thinking")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  referredByUserId    String?            @map("referred_by_user_id") @db.Uuid
  referredBy          User?              @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull, map: "users_referred_by_user_id_fkey")
  referrals           User[]             @relation("UserReferrals")
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  mentorAssignments   MentorAssignment[] @relation("MentorAssignments")
  menteeAssignment    MentorAssignment?   @relation("MenteeAssignment")
  questionnaireProfile UserQuestionnaireProfile?
  meals               Meal[]
  mealLikes           MealLike[]
  sharedRations       SharedRation[]
  sharedRationLikes   SharedRationLike[]
  mentorMealViewCursors MentorMenteeMealCursor[] @relation("MentorMealViewCursors")
  menteeMealViewCursors MentorMenteeMealCursor[] @relation("MenteeMealViewCursors")
  mentorMealViews       MentorMenteeMealView[]   @relation("MentorMealViews")
  menteeMealViews       MentorMenteeMealView[]   @relation("MenteeMealViews")
  planAssignments     PlanAssignment[]
  savedItems          UserSavedItems?
  planLibrary         UserPlanLibrary?
  mentorPlans         MentorPlan[]
  telegramLinkChallenges TelegramLinkChallenge[]
  newsPosts        NewsPost[]
  knowledgeBases   KnowledgeBase[]
  meetings         Meeting[]
  generationUsage  Json          @default("{}") @map("generation_usage")

  @@index([role], map: "users_role_idx")
  @@index([referredByUserId], map: "users_referred_by_user_id_idx")
  @@map("users")
}

enum MealSource {
  telegram
  manual

  @@map("meal_source")
}

model Meal {
  id               String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  title            String
  ingredients      String     @default("")
  category         String
  mealSlot         String     @map("meal_slot")
  recordedAt       DateTime   @map("recorded_at")
  kcal             Int
  protein          Int
  fat              Int
  carbs            Int
  portionItems     Json       @default("[]") @map("portion_items")
  clientComment    String     @default("") @map("client_comment")
  assumptions      Json       @default("[]")
  micronutrients   Json       @default("[]")
  versions         Json       @default("[]")
  activeVersionId  String?    @map("active_version_id") @db.Uuid
  source           MealSource @default(telegram)
  telegramUpdateId String?    @unique(map: "meals_telegram_update_id_key") @map("telegram_update_id")
  clientKey        String?    @map("client_key")
  imageKey         String?    @map("image_key")
  imageMime        String?    @map("image_mime")
  sharedAt         DateTime?  @map("shared_at")
  generationUsage  Json       @default("{}") @map("generation_usage")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "meals_user_id_fkey")
  likes            MealLike[]
  mentorViews      MentorMenteeMealView[]

  @@index([userId, recordedAt], map: "meals_user_id_recorded_at_idx")
  @@index([sharedAt], map: "meals_shared_at_idx")
  @@unique([userId, clientKey], map: "meals_user_id_client_key_key")
  @@map("meals")
}

model MealLike {
  mealId    String   @map("meal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade, map: "meal_likes_meal_id_fkey")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "meal_likes_user_id_fkey")

  @@id([mealId, userId], map: "meal_likes_pkey")
  @@index([mealId], map: "meal_likes_meal_id_idx")
  @@map("meal_likes")
}

model TelegramPollerCursor {
  id        String   @id
  offset    BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_poller_cursors")
}

model MentorPlan {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mentorId    String   @map("mentor_id") @db.Uuid
  title       String
  description String   @default("")
  goal        String
  source      String   @default("План наставника")
  image       String   @default("")
  days        Int      @default(7)
  mealsPerDay Int      @map("meals_per_day")
  meals       Json
  kcal        Int
  protein     Int
  fat         Int
  carbs       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  mentor      User     @relation(fields: [mentorId], references: [id], onDelete: Cascade, map: "mentor_plans_mentor_id_fkey")

  @@index([mentorId, updatedAt], map: "mentor_plans_mentor_id_updated_at_idx")
  @@map("mentor_plans")
}

model TelegramLinkChallenge {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  codeHash        String    @unique(map: "telegram_link_challenges_code_hash_key") @map("code_hash")
  claimedUsername String?   @map("claimed_username")
  claimedPhone    String?   @map("claimed_phone")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "telegram_link_challenges_user_id_fkey")

  @@index([userId, createdAt], map: "telegram_link_challenges_user_id_created_at_idx")
  @@map("telegram_link_challenges")
}

model PlanAssignment {
  userId      String   @id @map("user_id") @db.Uuid
  planIds     Json     @default("[]") @map("plan_ids")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "plan_assignments_user_id_fkey")

  @@map("plan_assignments")
}

model UserSavedItems {
  userId    String   @id @map("user_id") @db.Uuid
  mealIds   Json     @default("[]") @map("meal_ids")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_saved_items_user_id_fkey")

  @@map("user_saved_items")
}

model UserPlanLibrary {
  userId          String   @id @map("user_id") @db.Uuid
  authoredPlans   Json     @default("[]") @map("authored_plans")
  savedPlanIds    Json     @default("[]") @map("saved_plan_ids")
  selectedPlanIds Json     @default("[]") @map("selected_plan_ids")
  planStarts      Json     @default("[]") @map("plan_starts")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_plan_libraries_user_id_fkey")

  @@map("user_plan_libraries")
}

model SharedRation {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  authorId     String             @map("author_id") @db.Uuid
  sourcePlanId String             @map("source_plan_id") @db.VarChar(80)
  title        String
  description  String             @default("")
  goal         String?
  coverImage   String             @default("") @map("cover_image")
  days         Int                @default(1)
  meals        Json
  kcal         Int
  protein      Int
  fat          Int
  carbs        Int
  sharedAt     DateTime?          @map("shared_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "shared_rations_author_id_fkey")
  likes        SharedRationLike[]

  @@unique([authorId, sourcePlanId], map: "shared_rations_author_id_source_plan_id_key")
  @@index([sharedAt], map: "shared_rations_shared_at_idx")
  @@map("shared_rations")
}

model SharedRationLike {
  rationId  String       @map("ration_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  ration    SharedRation @relation(fields: [rationId], references: [id], onDelete: Cascade, map: "shared_ration_likes_ration_id_fkey")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "shared_ration_likes_user_id_fkey")

  @@id([rationId, userId], map: "shared_ration_likes_pkey")
  @@index([rationId], map: "shared_ration_likes_ration_id_idx")
  @@map("shared_ration_likes")
}

model UserQuestionnaireProfile {
  userId      String    @id @map("user_id") @db.Uuid
  answers     Json
  version     Int       @default(1)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_questionnaire_profiles_user_id_fkey")

  @@map("user_questionnaire_profiles")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@index([userId, createdAt], map: "password_reset_tokens_user_id_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

enum UserRole {
  user
  admin
  mentor

  @@map("user_role")
}

model MentorAssignment {
  menteeId  String   @id @map("mentee_id") @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  mentor    User     @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade, map: "mentor_assignments_mentor_id_fkey")
  mentee    User     @relation("MenteeAssignment", fields: [menteeId], references: [id], onDelete: Cascade, map: "mentor_assignments_mentee_id_fkey")

  @@index([mentorId, createdAt], map: "mentor_assignments_mentor_id_created_at_idx")
  @@map("mentor_assignments")
}

model MentorMenteeMealCursor {
  mentorId String   @map("mentor_id") @db.Uuid
  menteeId String   @map("mentee_id") @db.Uuid
  viewedAt DateTime @map("viewed_at")
  mentor   User     @relation("MentorMealViewCursors", fields: [mentorId], references: [id], onDelete: Cascade, map: "mentor_mentee_meal_cursors_mentor_id_fkey")
  mentee   User     @relation("MenteeMealViewCursors", fields: [menteeId], references: [id], onDelete: Cascade, map: "mentor_mentee_meal_cursors_mentee_id_fkey")

  @@id([mentorId, menteeId], map: "mentor_mentee_meal_cursors_pkey")
  @@index([mentorId], map: "mentor_mentee_meal_cursors_mentor_id_idx")
  @@map("mentor_mentee_meal_cursors")
}

model MentorMenteeMealView {
  mentorId String   @map("mentor_id") @db.Uuid
  menteeId String   @map("mentee_id") @db.Uuid
  mealId   String   @map("meal_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at")
  mentor   User     @relation("MentorMealViews", fields: [mentorId], references: [id], onDelete: Cascade, map: "mentor_mentee_meal_views_mentor_id_fkey")
  mentee   User     @relation("MenteeMealViews", fields: [menteeId], references: [id], onDelete: Cascade, map: "mentor_mentee_meal_views_mentee_id_fkey")
  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade, map: "mentor_mentee_meal_views_meal_id_fkey")

  @@id([mentorId, mealId], map: "mentor_mentee_meal_views_pkey")
  @@index([mentorId, menteeId], map: "mentor_mentee_meal_views_mentor_id_mentee_id_idx")
  @@map("mentor_mentee_meal_views")
}

model AuthSession {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  refreshTokenFamilyHash   String?   @unique(map: "auth_sessions_refresh_token_family_hash_key") @map("refresh_token_family_hash")
  previousRefreshTokenHash String?   @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime? @map("refresh_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent")
  ipAddress                String?   @map("ip_address")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model NewsPost {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  channelHandle  String   @map("channel_handle")
  telegramPostId Int      @map("telegram_post_id")
  text               String   @db.Text
  postedAt           DateTime @map("posted_at")
  media              Json     @default("[]")
  archiveChatId      String?  @map("archive_chat_id")
  archiveMessageIds  Json     @default("[]") @map("archive_message_ids")
  ad                 Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "news_posts_user_id_fkey")

  @@unique([userId, channelHandle, telegramPostId], map: "news_posts_user_channel_post_key")
  @@index([userId, postedAt], map: "news_posts_user_id_posted_at_idx")
  @@map("news_posts")
}

model KnowledgeBase {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  name      String          @db.VarChar(80)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "knowledge_bases_user_id_fkey")
  files     KnowledgeFile[]

  @@index([userId, updatedAt], map: "knowledge_bases_user_id_updated_at_idx")
  @@map("knowledge_bases")
}

model KnowledgeFile {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  baseId    String           @map("base_id") @db.Uuid
  name      String           @db.VarChar(180)
  mime      String           @default("") @db.VarChar(120)
  bytes     Int
  createdAt DateTime         @default(now()) @map("created_at")
  base      KnowledgeBase    @relation(fields: [baseId], references: [id], onDelete: Cascade, map: "knowledge_files_base_id_fkey")
  chunks    KnowledgeChunk[]

  @@index([baseId, createdAt], map: "knowledge_files_base_id_created_at_idx")
  @@map("knowledge_files")
}

model KnowledgeChunk {
  id       String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId   String        @map("file_id") @db.Uuid
  position Int
  text     String
  file     KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade, map: "knowledge_chunks_file_id_fkey")

  @@index([fileId, position], map: "knowledge_chunks_file_id_position_idx")
  @@map("knowledge_chunks")
}

enum MeetingStatus {
  queued
  running
  ready
  failed

  @@map("meeting_status")
}

model Meeting {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  title      String        @db.VarChar(160)
  fileName   String        @map("file_name") @db.VarChar(180)
  status     MeetingStatus @default(queued)
  jobId      String?       @map("job_id")
  speakers   Int?
  transcript String        @default("")
  segments   Json          @default("[]")
  error      String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "meetings_user_id_fkey")

  @@index([userId, updatedAt], map: "meetings_user_id_updated_at_idx")
  @@map("meetings")
}
