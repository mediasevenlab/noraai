# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
POSTGRES_PORT=54329
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/web_app_demo?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
POSTGRES_TEST_PORT=54330
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/web_app_demo_test?schema=public"

# Idempotent local administrator seed. Leave the password empty for a locked
# admin, or set 8-128 characters locally before `bun run prisma:seed`.
# Production backend-initial spec generation requires 12-128 non-placeholder
# characters and exposes these values only to the PRE_DEPLOY job.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006"
# Public browser-app origin used in transactional links such as password reset.
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_REUSE_GRACE_SECONDS="10"
SESSION_ABSOLUTE_TTL_DAYS="90"
SESSION_RETENTION_DAYS="7"
AUTH_BODY_LIMIT_BYTES="65536"
AUTH_RATE_LIMIT_MAX="60"
AUTH_RATE_LIMIT_WINDOW_SECONDS="60"
SHUTDOWN_GRACE_SECONDS="20"
TRUST_PROXY="false"
# Required when TRUST_PROXY=true. Use do-connecting-ip on DigitalOcean App Platform.
# For a comma-separated proxy chain, set first or last to match the provider contract.
# TRUSTED_PROXY_CLIENT_IP_HEADER="do-connecting-ip"
# TRUSTED_PROXY_CLIENT_IP_POSITION="first"
COOKIE_SECURE="false"

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"

# Optional Gemini (meal analysis via /api/internal/meals-gemini).
# Direct Google host may fail with regional restrictions. Legacy stack uses a
# Netherlands HTTPS proxy host + GEMINI_PROXY_TOKEN (not *.googleapis.com).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_MEAL_MODEL=""
GEMINI_API_HOST="generativelanguage.googleapis.com"
GEMINI_API_PORT="443"
GEMINI_PROXY_TOKEN=""
# When GEMINI_API_HOST is the Netherlands proxy (not *.googleapis.com), news
# import reads public channel pages at /tme/... and streams post media at
# /cdn with the X-Upstream-Url header. Auth reuses GEMINI_PROXY_TOKEN.
# Leave the Google host to call t.me directly.

# Shared secret for n8n ↔ backend internal meal routes (Bearer).
INTERNAL_SERVICE_TOKEN=""
INTERNAL_RATE_LIMIT_MAX="120"
INTERNAL_RATE_LIMIT_WINDOW_SECONDS="60"

# Local Telegram meals bot (polling). Leave blank to disable the poller.
TELEGRAM_MEALS_BOT_TOKEN=""
TELEGRAM_MEALS_BOT_USERNAME=""

# Mentor meal notifications bot (polling for bind + n8n delivery).
# Create via @BotFather; never commit the token. Local example username: meal_notifications_bot
TELEGRAM_NOTIFY_BOT_TOKEN=""
TELEGRAM_NOTIFY_BOT_USERNAME=""

# News archive bot. Private channel admin. Never commit the token.
TELEGRAM_NEWS_BOT_TOKEN=""
TELEGRAM_NEWS_BOT_USERNAME=""
# n8n publishes and deletes copies in the private archive channel.
N8N_NEWS_ARCHIVE_WEBHOOK_URL="http://127.0.0.1:5680/webhook/news-archive-sync"
# Leave empty to call api.telegram.org directly. On the Russia host set the
# foreign proxy base, for example https://89.124.122.90:8788/telegram
# Auth reuses GEMINI_PROXY_TOKEN.
TELEGRAM_API_BASE=""

# n8n meal analyze webhook (poller calls this; falls back to Gemini directly).
N8N_MEAL_WEBHOOK_URL="http://127.0.0.1:5680/webhook/meal-diary-analyze"

# YooKassa test shop. Leave blank here. Put the live values in backend/.env only.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# n8n in-app add-meal webhook (diary modal; falls back to N8N_MEAL_WEBHOOK_URL, then Gemini).
N8N_APP_MEAL_WEBHOOK_URL="http://127.0.0.1:5680/webhook/meal-app-analyze"

# Office models for users who pick Nora in Settings. The key stays in this file, never in git.
# Photo requests use LLM_VISION_MODEL. Text-only requests use LLM_TEXT_MODEL. One GPU, so the
# backend sends them one at a time. If the webhook is down, the backend calls the API directly.
LLM_BASE_URL="https://llm.25nutrition.site/v1"
LLM_API_KEY=""
LLM_TEXT_MODEL="qwen3.5:9b"
LLM_VISION_MODEL="qwen2.5vl:7b"
# Office speech (GigaAM) and web search (SearXNG). Local Compose publishes search on
# 127.0.0.1:18080. On Nora the server env uses the docker-network address on port 8080.
LLM_STT_URL="http://172.19.0.2:8080"
LLM_SEARCH_URL="http://127.0.0.1:18080"
# Long meeting transcription (GigaAM + speaker split). On Nora the backend
# reaches it by docker name, not by the host port 18152.
LLM_MEETINGS_URL="http://meetings:8080"
N8N_NORA_MEAL_WEBHOOK_URL="http://127.0.0.1:5680/webhook/meal-nora-analyze"

# n8n voice-to-text webhook (meal composer; falls back to Gemini directly).
N8N_TRANSCRIBE_WEBHOOK_URL="http://127.0.0.1:5680/webhook/meal-voice-transcribe"

# n8n mentor meal notification webhook (backend posts after a mentee meal is saved).
N8N_MENTOR_NOTIFY_WEBHOOK_URL="http://127.0.0.1:5680/webhook/mentor-meal-notify"

# Optional local directory for meal images (default: backend/uploads/meals).
# MEALS_UPLOAD_DIR=""
