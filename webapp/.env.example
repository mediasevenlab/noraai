# Empty = call same-origin /api/* through the Vite proxy (see vite.config.ts).
# This keeps auth cookies working whether you open the app as localhost or 127.0.0.1.
# For a direct backend URL instead, set e.g. VITE_API_URL=http://127.0.0.1:3000
# and open the webapp on that same hostname.
VITE_API_URL=
