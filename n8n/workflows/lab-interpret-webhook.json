  "nodes": [
    {
      "parameters": {
        "content": "## Интерпретация\nWebhook из **Расшифровка / Анализы**: массив анализов → Gemini на хосте → сводная interpretation.\nШаги `Шаг: …` обновляют прогресс в UI.",
        "height": 200,
        "width": 340,
        "color": 4
      },
      "id": "c3000001-0000-4000-8000-000000000100",
      "name": "Note: обзор",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -380,
        -40
      ]
    },
    {
      "parameters": {
        "content": "### Webhook\nПринимает **POST** `{ analyses[], jobId }`.\nОтвет отдаёт нода **Ответ**.",
        "height": 160,
        "width": 220,
        "color": 5
      },
      "id": "c3000001-0000-4000-8000-000000000101",
      "name": "Note: Webhook",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -220
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lab-interpret",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3000001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "lab-interpret",
      "notes": "Вход: analyses[] + jobId. Path: lab-interpret"
    },
    {
      "parameters": {
        "content": "### Подготовить данные\nДостаёт `analyses`, `jobId`, `sourceIds`, задаёт `host` Docker→хост.",
        "height": 160,
        "width": 220,
        "color": 3
      },
      "id": "c3000001-0000-4000-8000-000000000102",
      "name": "Note: Подготовить данные",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = items[0].json || {};\nconst analyses = body.analyses || body.body?.analyses || [];\nconst jobId = body.jobId || body.body?.jobId || '';\nif (!Array.isArray(analyses) || !analyses.length) {\n  throw new Error('analyses[] пуст — нечего интерпретировать');\n}\nreturn [{\n  json: {\n    analyses,\n    jobId,\n    sourceIds: body.sourceIds || analyses.map((a) => a.id).filter(Boolean),\n    host: 'http://host.docker.internal:8787',\n  },\n}];"
      },
      "id": "c3000001-0000-4000-8000-000000000002",
      "name": "Подготовить данные",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "notes": "Проверка analyses[] + host.docker.internal:8787"
    },
    {
      "parameters": {
        "content": "### Шаг: prepare done\nUI: данные подготовлены (`n8n_prepare`).\n`continueOnFail` — UI не ломает пайплайн.",
        "height": 160,
        "width": 220,
        "color": 6
      },
      "id": "c3000001-0000-4000-8000-000000000103",
      "name": "Note: prepare done",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        460,
        -220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.host }}/api/jobs/{{ $json.jobId }}/step",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: 'n8n_prepare', status: 'done', detail: 'Данные анализов подготовлены' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "c3000001-0000-4000-8000-000000000010",
      "name": "Шаг: prepare done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "continueOnFail": true,
      "notes": "SSE/прогресс: n8n_prepare = done"
    },
    {
      "parameters": {
        "content": "### Шаг: gemini running\nUI: «идёт интерпретация Gemini» (`n8n_gemini` running).",
        "height": 160,
        "width": 220,
        "color": 6
      },
      "id": "c3000001-0000-4000-8000-000000000104",
