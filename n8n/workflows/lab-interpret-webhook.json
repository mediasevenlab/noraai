        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: 'n8n_gemini', status: 'running', detail: 'Запрос к Gemini' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "c3000001-0000-4000-8000-000000000011",
      "name": "Шаг: gemini running",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        0
      ],
