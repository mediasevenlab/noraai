    },
    {
      "parameters": {
        "content": "### Собрать ответ\nНормализует ответ в `{ ok, interpretation }` или `{ ok:false, error }` для lab-ui.",
        "height": 160,
        "width": 220,
        "color": 3
      },
      "id": "c3000001-0000-4000-8000-000000000107",
      "name": "Note: Собрать ответ",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1340,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Подготовить данные').first().json;\nconst res = $('Gemini интерпретация').first().json || {};\nif (res.ok && res.interpretation) {\n  return [{\n    json: {\n      ok: true,\n      model: res.model,\n      interpretation: res.interpretation,\n      sourceIds: prev.sourceIds,\n      via: 'n8n->host-gemini',\n    },\n  }];\n}\nreturn [{\n  json: {\n    ok: false,\n    error: res.error || res.message || JSON.stringify(res).slice(0, 400),\n  },\n}];"
      },
      "id": "c3000001-0000-4000-8000-000000000004",
      "name": "Собрать ответ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        0
      ],
      "notes": "ok+interpretation или error для webhook response"
    },
