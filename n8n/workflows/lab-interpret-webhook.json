      "notes": "SSE/прогресс: n8n_gemini = running"
    },
    {
      "parameters": {
        "content": "### Gemini интерпретация\nГлавный вызов: `POST /api/internal/interpret`.\nАнализы → **interpretation** (таблицы, alerts, summary).",
        "height": 180,
        "width": 240,
        "color": 2
      },
      "id": "c3000001-0000-4000-8000-000000000105",
      "name": "Note: Gemini",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
