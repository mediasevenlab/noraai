    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Подготовить PDF').item.json.host }}/api/jobs/{{ $('Подготовить PDF').item.json.jobId }}/step",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: 'n8n_assemble', status: 'done' }) }}",
        "options": {
