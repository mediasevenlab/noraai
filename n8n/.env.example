# Compose reads this file with --env-file when starting n8n.
N8N_HOST_PORT=5680
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=replace-with-a-local-random-password

# Must remain stable after n8n has stored credentials. Generate with:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Local-only HTTP configuration.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5680
WEBHOOK_URL=http://localhost:5680/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Etc/UTC

# Shared with backend INTERNAL_SERVICE_TOKEN (meal-diary webhook → /api/internal/meals-gemini).
INTERNAL_SERVICE_TOKEN=
# Mentor notifications bot token (same value as backend TELEGRAM_NOTIFY_BOT_TOKEN). Never commit.
TELEGRAM_NOTIFY_BOT_TOKEN=
# News archive bot and the private channel id. Never commit the token.
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHANNEL_ID=
# Empty calls api.telegram.org. On the Russia host use the foreign proxy, same token as Gemini.
TELEGRAM_API_BASE=
GEMINI_PROXY_TOKEN=
# Allow Code nodes to read $env.INTERNAL_SERVICE_TOKEN and $env.TELEGRAM_NOTIFY_BOT_TOKEN.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
