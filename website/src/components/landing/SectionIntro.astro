---
import ScrollRevealText from './ScrollRevealText.tsx'

interface Props {
  align?: 'center' | 'left'
  description: string
  eyebrow: string
  title: string
  titleId?: string
}

const { align = 'left', description, eyebrow, title, titleId } = Astro.props
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class="text-sm font-semibold tracking-wide text-[color:var(--brand)] uppercase">{eyebrow}</p>
  <ScrollRevealText
    client:visible
    as="h2"
    className="mt-3 font-heading text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
    id={titleId}
    text={title}
    variant="primary"
  />
  <ScrollRevealText
    client:visible
    as="p"
    className="mt-4 text-base leading-7 text-muted-foreground text-pretty sm:text-lg"
    text={description}
    variant="secondary"
  />
</div>
