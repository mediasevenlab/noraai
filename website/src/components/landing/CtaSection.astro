---
import { ArrowRight } from 'lucide-react'

import { buttonVariants } from '@/components/ui/button'
import { Card, CardContent } from '@/components/ui/card'
import ScrollRevealText from './ScrollRevealText.tsx'

interface Props {
  loginHref: string
  signupHref: string
}

const { loginHref, signupHref } = Astro.props
---

<section class="py-20 sm:py-24" id="cta" aria-labelledby="cta-title">
  <div class="site-container">
    <Card className="relative overflow-hidden border-[color:var(--landing-tint-soft)] bg-[color:var(--landing-tint-softer)] py-0 shadow-sm">
      <div
        class="absolute -right-24 -top-24 size-72 rounded-full bg-[color:var(--landing-tint-soft)] blur-3xl"
        aria-hidden="true"
      ></div>
      <CardContent className="relative flex flex-col items-start justify-between gap-8 p-7 sm:p-10 lg:flex-row lg:items-center lg:p-12">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-wide text-[color:var(--brand)] uppercase">Готовы начать?</p>
          <ScrollRevealText
            client:visible
            as="h2"
            className="mt-3 font-heading text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
            id="cta-title"
            text="Откройте 24nutrition и соберите первый день питания."
            variant="primary"
          />
          <ScrollRevealText
            client:visible
            as="p"
            className="mt-4 text-base leading-7 text-muted-foreground text-pretty sm:text-lg"
            text="Войдите в аккаунт или зарегистрируйтесь — дальше дневник, планы и наставник уже внутри."
            variant="secondary"
          />
        </div>
        <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row">
          <a
            class={buttonVariants({ className: 'h-11 shrink-0 px-5', size: 'lg' })}
            href={signupHref}
          >
            Регистрация
            <ArrowRight data-icon="inline-end" aria-hidden="true" />
          </a>
          <a
            class={buttonVariants({ className: 'h-11 shrink-0 px-5', size: 'lg', variant: 'outline' })}
            href={loginHref}
          >
            Войти
          </a>
        </div>
      </CardContent>
    </Card>
  </div>
</section>
