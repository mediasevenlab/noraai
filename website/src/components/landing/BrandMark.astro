---
import { GalleryVerticalEnd } from 'lucide-react'

interface Props {
  compact?: boolean
  /** Light mark for dark floating nav. */
  inverse?: boolean
}

const { compact = false, inverse = false } = Astro.props
---

<span class="inline-flex items-center gap-2.5" aria-label="24nutrition">
  <span
    class:list={[
      'grid size-8 place-items-center rounded-lg',
      inverse
        ? 'bg-white text-neutral-950'
        : 'bg-[#0099ff] text-white',
    ]}
    aria-hidden="true"
  >
    <GalleryVerticalEnd className="size-4" aria-hidden="true" />
  </span>
  {
    !compact && (
      <span
        class:list={[
          'font-heading text-base font-semibold tracking-tight',
          inverse ? 'text-white' : 'text-foreground',
        ]}
      >
        Nutrition
      </span>
    )
  }
</span>
