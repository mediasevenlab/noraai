---
import BenefitsSection from '@/components/landing/BenefitsSection.astro'
import DarkCtaSection from '@/components/landing/DarkCtaSection.astro'
import FaqSection from '@/components/landing/FaqSection.astro'
import FeatureShowcase from '@/components/landing/FeatureShowcase.astro'
import MosaicShowcase from '@/components/landing/MosaicShowcase.astro'
import SiteFooter from '@/components/landing/SiteFooter.astro'
import SiteHeader from '@/components/landing/SiteHeader.astro'
import TestimonialsSection from '@/components/landing/TestimonialsSection.astro'
import WhyChooseSection from '@/components/landing/WhyChooseSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '24nutrition — дневник питания и планы'
const description =
  'Ведите дневник питания, собирайте недельные планы и работайте с наставником в 24nutrition. Войдите или зарегистрируйтесь, чтобы открыть приложение.'
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const publicWebappUrl = (import.meta.env.PUBLIC_WEBAPP_URL ?? '').replace(/\/$/, '')
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

function webappHref(path: `/${string}`) {
  return `${publicWebappUrl}${path}`
}

const loginHref = webappHref('/login')
const signupHref = webappHref('/signup')
// The diary page is served on this same host in production. Baking localhost
// into the static page makes a phone load an empty frame: the address points
// at the phone itself, so neither the cards nor the smoke inside that frame appear.
const authDemoBase = publicWebappUrl
  ? `${publicWebappUrl}/embed/auth-demo`
  : import.meta.env.DEV
    ? 'http://localhost:5173/embed/auth-demo'
    : '/embed/auth-demo'
const authDemoSrcs = [
  `${authDemoBase}?surface=login`,
  `${authDemoBase}?surface=signup-user`,
  `${authDemoBase}?surface=signup-mentor`,
]
---

<BaseLayout canonicalUrl={canonicalUrl} description={description} title={title}>
  <Fragment slot="head">
    <style is:inline>
      html.landing-session-check body { visibility: hidden; }
    </style>
    <script is:inline define:vars={{ publicWebappUrl }}>
      ;(function () {
        var appBase = publicWebappUrl || ''
        var root = document.documentElement
        var settled = false
        root.classList.add('landing-session-check')

        function reveal() {
          if (settled) return
          settled = true
          root.classList.remove('landing-session-check')
        }

        function destination(user) {
          if (!user) return '/app/general'
          if (user.role === 'admin') return '/admin/users'
          if (user.role === 'mentor') return '/mentor'
          if (user.questionnaireCompleted === false) return '/app/onboarding'
          return '/app/general'
        }

        function probe() {
          return fetch(appBase + '/api/auth/refresh', {
            method: 'POST',
            credentials: 'include',
            headers: { 'content-type': 'application/json' },
            body: '{}',
          })
            .then(function (response) {
              if (!response.ok) return null
              return response.json()
            })
            .then(function (session) {
              if (!session || typeof session.accessToken !== 'string') return null
              return fetch(appBase + '/api/auth/me', {
                credentials: 'include',
                headers: { authorization: 'Bearer ' + session.accessToken },
              }).then(function (response) {
                if (!response.ok) return { user: null }
                return response.json()
              })
            })
            .then(function (body) {
              if (!body) {
                reveal()
                return
              }
              settled = true
              window.location.replace(appBase + destination(body.user))
            })
        }

        var timer = window.setTimeout(reveal, 2500)
        var locks = navigator.locks
        var pending = locks
          ? locks.request('web_app_demo:auth-cookie-mutation', { mode: 'exclusive' }, probe)
          : probe()
        pending.catch(reveal).then(function () {
          window.clearTimeout(timer)
        })
      })()
    </script>
  </Fragment>
  <SiteHeader loginHref={loginHref} signupHref={signupHref} />
  <main id="main-content">
    <MosaicShowcase />
    <WhyChooseSection href={signupHref} />
    <BenefitsSection demoSrcs={authDemoSrcs} signupHref={signupHref} />
    <FeatureShowcase />
    <TestimonialsSection />
    <FaqSection />
    <DarkCtaSection loginHref={loginHref} signupHref={signupHref} />
  </main>
  <SiteFooter loginHref={loginHref} signupHref={signupHref} />
</BaseLayout>
